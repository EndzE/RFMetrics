{
  "_meta": {
    "source": "https://github.com/gfxdisp/ColorVideoVDP/blob/main/pycvvdp/vvdp_data/display_models.json",
    "note": "Normalized for FFVship --displayConfig (single-object values keyed by model key). Every entry verified live against FFVship 5.1.1 on 60 frames of a 1600x1080p60 transcode pair: embedded twins reproduce exactly, the rest strict-parse with stable JODs.",
    "normalization": [
      "viewing_distance_inches * 0.0254 -> viewing_distance_meters",
      "contrast = max_luminance / min_luminance where upstream gives min_luminance",
      "colorspace injected (upstream omits it on SDR entries): SDR unless HDR content needs BT.2020-PQ / BT.2020-HLG / BT.709-linear",
      "k_refl 0.005 + exposure 1.0 defaults where upstream omits them (official-tool defaults; exact-score reproductions confirm)"
    ]
  },
